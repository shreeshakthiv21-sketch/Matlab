clc
clear
close

x= input("Enter the input sequence")
y= input("Enter the second input sequence")
m=length(x)
n= length(y)
if m>n
    y= [y zeros(1,m-n)]
else
    x=[x zeros(1,n-m)]
end

c= xcorr(x,y)

subplot(3,1,1)
stem(x)
title('Input signal')

subplot(3,1,2)
stem(y)
title('Second input signal')

subplot(3,1,3)
stem(c)
title('Cross correlated signal')
