clc
clear
close

x=input("Enter the input ");
N=input("Enter the n point value ");

L= length(x)
if L<N
    x= [x zeros(1,N-L)];
end

for k =0:N-1
    X(k+1)=0;
    for n = 0:N-1
     X(k+1)= X(k+1)+ x(n+1)*exp(-1j*2*pi*k*n/N) ; 
    end
end

disp('The DFT of the sequence is ')
disp(X);

subplot(3,1,1)
stem(0:N-1,x)
title("Input sequence")
xlabel('samples')

subplot(3,1,2)
stem(0:N-1, abs(X))
title("DFT magnitude sequence")
xlabel('K')
ylabel('|x(k)|')
grid on

subplot(3,1,3)
stem(0:N-1, angle(X))
title("DFT phase sequence")
xlabel('K')
ylabel('angle x(K)')
grid on
    
