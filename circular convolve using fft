clc
clear all
close all

x=input('Enter first sequence:');
h=input('Enter second sequence:');

N=max(length(x),length(h));

X=fft(x,N);
H=fft(h,N);

y=ifft(X.*H);

disp('Circular Convolution Output:')
disp(y)

subplot(3,1,1)
stem(x)
title('Input x')

subplot(3,1,2)
stem(h)
title('Input h')

subplot(3,1,3)
stem(y)
title('Circular Convolution')
