clc
clear all
close all

x=input('Enter input sequence x:');
h=input('Enter impulse response h:');

N=max(length(x),length(h));

y=cconv(x,h,N);

disp('Circular Convolution Output:')
disp(y)

subplot(3,1,1)
stem(0:length(x)-1,x)
title('Input Sequence')

subplot(3,1,2)
stem(0:length(h)-1,h)
title('Impulse Response')

subplot(3,1,3)
stem(0:N-1,y)
title('Circular Convolution')
