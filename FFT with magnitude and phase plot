clc
close
clear

x= input("Enter the input sequence");
N= input("Enter the N of input sequence");

L= length(x)
if L <= N
    x=[ x zeros(1,N-L)];
end

X= fft(x,N)

disp("The fft of the given sequence");
disp(X);

subplot(3,1,1)
stem (0:N-1,x)
title("INPUT SEQUENCE");
xlabel('Samples-->');
ylabel('Amplitude');
grid on;

subplot(3,1,2)
stem(0:N-1, abs(X))
title("MAGNITUDE RESPONSE");
xlabel('k-->');
ylabel('|X(k)|');
grid on;

subplot(3,1,3)
stem(0:N-1, angle(X))
title("PHASE RESPONSE");
xlabel('k-->');
ylabel('Angle(X(K))');
grid on;
