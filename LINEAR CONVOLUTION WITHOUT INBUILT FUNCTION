clc
clear
close

x= input("Enter the input response:");
h= input("Enter the impulse response: ");
LX= length(x);
LH= length(h);
N= LX+LH-1;
y= zeros(1,N);
for n=1:LX
    for k= 1:LH
        y(n+k-1)= y(n+k-1)+ x(n)*h(k);
    end
end


disp("LINEAR CONVOLUTION")
disp(y);

subplot(3,1,1)
stem(x);
title("x(n)");
grid on

subplot(3,1,2)
stem(h);
title("h(n)");
grid on

subplot(3,1,3)
stem(y)
title("LINEAR CONVOLUTION");
grid on

