clc
clear all
close all

x=input('Enter the input sequence:');
h=input('Enter the  value:');
y=conv(x,h)
m=length(x)
n=length(y)
o=length(h)
subplot(3,1,1)
stem(0:m-1, x)
title('Input Signal')

subplot(3,1,2)
stem(0:o-1,h)
title('Magnitude Response')

subplot(3,1,3)
stem(0:n-1,y)
title('Phase Response')
